{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nieuwjaar",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-06",
  "triggers": { "crons": ["30 2 * * *"] },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nieuwjaar-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nieuwjaar-db",
      "database_id": "02bc8410-117b-4c12-be0b-3fabcf429588",
      "migrations_dir": "migrations"
    }
  ]
}