{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nieuwjaar",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nieuwjaar-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nieuwjaar-db",
      "database_id": "02bc8410-117b-4c12-be0b-3fabcf429588",
      "migrations_dir": "migrations"
    }
  ]
}